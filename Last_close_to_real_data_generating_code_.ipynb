    # Transfer/discharge destination (simple)
    discharge_destination = weighted_choice([
        ("WARD", 0.70),
        ("OTHER_HOSPITAL", 0.08),
        ("ANOTHER_ICU", 0.07),
        ("HOME", 0.10),
